# ==========================================
# EventPulse - Environment Configuration (.end)
# ==========================================

# Application Settings
VITE_APP_TITLE=EventPulse
VITE_APP_NAME="EventPulse - Events Management"
VITE_APP_VERSION=1.0.0
VITE_PORT=2220

# API & Backend Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Local Storage Key Prefixes
VITE_STORAGE_EVENTS_KEY=eventpulse_events
VITE_STORAGE_SAVED_KEY=eventpulse_saved

# Feature Toggles
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_MODE=false
